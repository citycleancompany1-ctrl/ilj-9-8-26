rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Vendor Stores: Public read for live directory and shop showcases
    match /shops/{shopId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Global Platform Configuration (pricing, popups, hero, settings, leads)
    match /platform_config/{configId} {
      allow read: if true;
      allow write: if true;
    }

    // Centralized Themes & Templates
    match /themes/{themeId} {
      allow read: if true;
      allow write: if true;
    }

    // Isolated Backups & Snapshots
    match /backups/{backupId} {
      allow read: if true;
      allow write: if true;
    }

    // Fallback rule for backward compatibility
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
